/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.idea/
*:Zone.Identifier
*Zone.Identifier
scoring-server/.venv/
__pycache__/

# AI 하니스의 기본 출력(--out 없이 돌린 것). 마지막 실행이 덮어써서
# 어느 회차인지 알 수 없다 — 커밋하지 않는다.
# ★ 남길 회차는 --out=data/probe/<이름>.json 으로 받아라.
#   그쪽은 커밋한다. 관측 원본이 없으면 결론을 재현할 수 없다.
#   인수인계_세션13.md 12-6장에 대응표가 있다.
ai-probe.json
